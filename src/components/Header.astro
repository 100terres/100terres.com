---
import Container from "~/components/Container.astro";
import Typography from "~/components/Typography.astro";
import { getTranslation } from "~/utils/i18n";

const translations = {
  en: {
    brand: {
      url: "/",
      tagline: "Software Developer",
    },
    langSwitch: {
      url: "/fr",
      label: "En\u00A0français",
    },
  },
  fr: {
    brand: {
      url: "/fr",
      tagline: "Développeur logiciel",
    },
    langSwitch: {
      url: "/",
      label: "In\u00A0English",
    },
  },
} as const;

const { t } = getTranslation(Astro, translations);
---

<header class="component-header">
  <Container class="layout">
    <div class="brand">
      <a href={t.brand.url} class="title">
        100terres
      </a>
      <Typography class="tagline">{t.brand.tagline}</Typography>
    </div>

    <nav>
      <ul>
        <li>
          <a href="https://mastodon.100terres.com/@gab">Mastodon</a>
        </li>
        <li>
          <a href="https://codeberg.org/100terres">Codeberg</a>
        </li>
        <li>
          <a href="https://github.com/100terres">GitHub</a>
        </li>
        <li>
          <a href={t.langSwitch.url}>{t.langSwitch.label}</a>
        </li>
      </ul>
    </nav>
  </Container>
</header>

<style is:global>
  .component-header {
    .layout {
      display: grid;
      grid-template-columns: auto auto;
      justify-content: space-between;
      align-items: center;
      gap: 0;
    }

    .brand {
      .title {
        font-size: var(--size-large);
        font-weight: 700;
      }

      .tagline {
        margin: 0;
      }
    }

    nav {
      justify-self: end;
    }

    ul {
      align-items: center;
      display: flex;
      flex-wrap: wrap;
      gap: 0 calc(var(--size-micro) * 2);
      margin: 0;
      padding: 0;
    }

    li {
      display: block;
    }

    @media (width <= 600px) {
      .layout {
        grid-template-columns: 1fr;
      }

      nav {
        justify-self: start;
      }
    }
  }
</style>
