---
import Container from "~/components/Container.astro";
import Typography from "~/components/Typography.astro";
import ThemeSwitch from "~/components/ThemeSwitch.astro";

import { getCurrentLocale } from "~/utils/i18n";

import { Content as FooterContentEn } from "./FooterContent-en.md";
import { Content as FooterContentFr } from "./FooterContent-fr.md";
import GeneratedAtEn from "./GeneratedAt-en.astro";
import GeneratedAtFr from "./GeneratedAt-fr.astro";

const date = new Date(import.meta.env.BUILD_TIME);
const currentLocale = getCurrentLocale(Astro);
---

<footer class="component-footer">
  <Container class="layout">
    <ThemeSwitch />

    {currentLocale === "fr" ? <FooterContentFr /> : <FooterContentEn />}

    <Typography>
      {currentLocale === "fr" ? (
        <GeneratedAtFr date={date} />
      ) : (
        <GeneratedAtEn date={date} />
      )}
    </Typography>

    <Typography>&copy; {date.getUTCFullYear()} Gab</Typography>
  </Container>
</footer>

<style is:global>
  .component-footer {
    .layout {
      display: grid;
      row-gap: var(--size-small);
    }

    p {
      font-size: 0.75rem;
      margin: 0;
    }
  }
</style>
